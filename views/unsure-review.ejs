<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Unsure words</title>

    <link rel="stylesheet" href="/css/shared.css">
    <link rel="stylesheet" href="/css/unsure-review.css">
</head>

<body>
    <div class="unsure-review-layout">
        <aside class="unsure-review-sidebar">
            <div class="unsure-review-sidebar-header">
                <h2>Unsure word list</h2>
                <input id="unsureSearchInput" class="unsure-search-input" type="text" placeholder="Search Japanese..."
                    autocomplete="off">
            </div>
            <div id="unsureSearchResults" class="unsure-search-results" aria-label="Unsure word list"></div>
            <div class="unsure-review-sidebar-footer">
                <span id="unsureSearchResultCount" aria-live="polite"></span>
                <button class="confirm-btn" id="btnConfirm" disabled>Confirm</button>
            </div>
        </aside>
        <main class="content">
            <div class="container">
                <div class="unsure-review-panel">
                    <div id="unsureReviewContent" class="unsure-review-region" aria-live="polite"></div>
                </div>
            </div>
        </main>
    </div>
    <div class="overlay" id="mergeModal">
        <div class="modal-box unsure-merge-modal">
            <h3>Merge unsure word</h3>
            <p class="unsure-merge-source">Selected unsure word: <span id="mergeModalTargetWord"></span></p>
            <p class="unsure-merge-selected">Merge with: <span id="mergeModalSelectedWord"></span></p>
            <input class="modal-search" id="mergeModalSearchInput" type="text" placeholder="Search permanent words..."
                autocomplete="off">
            <div class="modal-list" id="mergeModalList"></div>
            <div class="modal-actions">
                <button class="modal-btn" id="mergeModalCancel">Cancel</button>
                <button class="modal-btn confirm" id="mergeModalConfirm" disabled>Confirm</button>
            </div>
        </div>
    </div>
    <div class="overlay" id="confirmOverlay">
        <div class="overlay-box">
            <h3>Confirming: <span id="confirmOverlayProgress"></span></h3>
            <span id="confirmOverlayMessage"></span>
            <button class="modal-btn" id="confirmOverlayClose" hidden>Close</button>
        </div>
    </div>
    <script type="module" src="/tools.helper.js"></script>
    <script type="module" src="/api.helper.js"></script>
    <script type="module" src="/unsure-review.js"></script>
</body>

</html>
