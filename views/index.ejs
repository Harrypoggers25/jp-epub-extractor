<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Japanese Dictionary</title>

    <style>
        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            height: 100%;
            font-family: Inter, Arial, sans-serif;
            background: #181a1b;
            color: #e8e6e3;
        }

        .layout {
            display: flex;
            height: 100vh;
        }

        /* ===========================
            Sidebar
        ============================ */

        .sidebar {
            width: 320px;
            background: #1e2021;
            border-right: 1px solid #333;
            display: flex;
            flex-direction: column;
        }

        .sidebar-header {
            padding: 20px;
            border-bottom: 1px solid #2a2c2d;
        }

        .sidebar-header h2 {
            margin: 0 0 16px;
            font-size: 24px;
            color: #e8e6e3;
        }

        .search-input {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid #444;
            border-radius: 10px;
            font-size: 15px;
            outline: none;
            background: #131415;
            color: #e8e6e3;
        }

        .search-input:focus {
            border-color: #7c8aff;
        }

        .search-results {
            flex: 1;
            overflow-y: auto;
        }

        .search-item {
            padding: 14px 20px;
            padding-left: 16px;
            border-bottom: 1px solid #262829;
            border-left: 4px solid #999;
            cursor: pointer;
            transition: background .2s;
        }

        .search-item.active {
            background: #1b2038;
            border-left: 4px solid #7c8aff;
        }

        .search-item.modified {
            background: #14211a;
            border-left: 4px solid #5cbf60;
        }

        .search-item.active.modified {
            background: #1b2b2a;
            border-left: 4px solid #5cc8b5;
        }

        .search-item:hover {
            background: #181a1b;
        }

        .search-item.active:hover {
            background: #232b4d;
        }

        .search-item.modified:hover {
            background: #1b2d23;
        }

        .search-item.active.modified:hover {
            background: #223635;
        }

        .search-word {
            font-size: 20px;
            font-weight: bold;
            color: #e8e6e3;
        }

        .search-word-type {
            color: #999;
            margin-top: 3px;
            font-size: 14px;
        }

        /* ===========================
            Content
        ============================ */

        .content {
            flex: 1;
            overflow-y: auto;
            padding: 40px;
        }

        .container {
            max-width: 900px;
            margin: auto;
        }

        .header {
            background: #1e2021;
            padding: 24px;
            border-radius: 14px;
            margin-bottom: 24px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, .4);
            border: 1px solid #333;
        }

        .header h1 {
            margin: 0;
            font-size: 38px;
            color: #e8e6e3;
        }

        .meta {
            margin-top: 10px;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .badge {
            background: #1b2038;
            color: #7c8aff;
            padding: 6px 12px;
            border-radius: 999px;
            font-size: 14px;
            align-content: center;
        }

        .entry {
            background: #1e2021;
            border-radius: 14px;
            padding: 22px;
            margin-bottom: 20px;
            border: 1px solid #333;
            box-shadow: 0 8px 30px rgba(0, 0, 0, .5);
            cursor: pointer;
        }

        .entry:hover {
            border-color: #263CAB;
            box-shadow: 0 8px 30px rgba(16, 26, 74, .22);
            < !-- background: #1b2038;
            -->
        }

        .entry:hover .word {
            < !-- background: #181a1b;
            -->
        }

        .entry:hover .sense {
            < !-- background: #14161f;
            -->
        }

        .entry.selected {
            border-color: #5cbf60;
            box-shadow: 0 8px 30px rgba(76, 175, 80, .22);
        }

        .entry-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .slug {
            font-size: 30px;
            font-weight: bold;
            color: #e8e6e3;
        }

        .common {
            background: #5cbf60;
            color: #0d0f0f;
            padding: 5px 12px;
            border-radius: 999px;
            font-size: 13px;
        }

        .jlpt {
            background: #ffab40;
            color: #0d0f0f;
            padding: 5px 12px;
            border-radius: 999px;
            margin-left: 8px;
            font-size: 13px;
        }

        .section {
            margin-top: 18px;
        }

        .section h3 {
            margin-bottom: 10px;
            color: #999;
            font-size: 15px;
            text-transform: uppercase;
            letter-spacing: .08em;
        }

        .word {
            display: inline-block;
            margin: 6px;
            padding: 10px 14px;
            background: #232527;
            border-radius: 10px;
        }

        .word strong {
            display: block;
            font-size: 22px;
            color: #e8e6e3;
        }

        .word span {
            color: #999;
        }

        .sense {
            padding: 12px;
            border-left: 4px solid #7986cb;
            background: #16181d;
            margin-bottom: 10px;
        }

        .definitions {
            font-size: 17px;
            margin-bottom: 8px;
            color: #e8e6e3;
        }

        .tags {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 8px;
        }

        .tag {
            background: #2c2c2c;
            border-radius: 999px;
            padding: 4px 10px;
            font-size: 13px;
            color: #ccc;
        }
    </style>
</head>

<body>
    <div class="layout">
        <aside class="sidebar">
            <div class="sidebar-header">
                <h2>Word list</h2>
                <input id="searchInput" class="search-input" type="text" placeholder="Search Japanese..."
                    autocomplete="off">
            </div>
            <div id="searchResults" class="search-results">
                <!-- Search results inserted here -->
                <!-- Example -->
                <!--
                <div class="search-item active">
                    <div class="search-word">買い物</div>
                    <div class="search-word-type">かいもの</div>
                </div>
                <div class="search-item">
                    <div class="search-word">買い物帰り</div>
                    <div class="search-word-type">かいものがえり</div>
                </div>
                -->
            </div>
        </aside>
        <main class="content">
            <div class="container">
                <div class="header">
                    <h1 id="basicForm"></h1>
                    <div class="meta">
                        <div id="tokenId" class="badge"></div>
                        <div id="wordType" class="badge"></div>
                        <div id="count" class="badge"></div>
                    </div>
                </div>
                <div id="entries"></div>
            </div>
        </main>
    </div>
    <script src="/index.js"></script>
</body>

</html>
