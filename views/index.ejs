<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Japanese Dictionary</title>

    <style>
        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            height: 100%;
            font-family: Inter, Arial, sans-serif;
            background: #f5f7fb;
            color: #222;
        }

        .layout {
            display: flex;
            height: 100vh;
        }

        /* ===========================
            Sidebar
        ============================ */

        .sidebar {
            width: 320px;
            background: white;
            border-right: 1px solid #ddd;
            display: flex;
            flex-direction: column;
        }

        .sidebar-header {
            padding: 20px;
            border-bottom: 1px solid #eee;
        }

        .sidebar-header h2 {
            margin: 0 0 16px;
            font-size: 24px;
        }

        .search-input {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid #ccc;
            border-radius: 10px;
            font-size: 15px;
            outline: none;
        }

        .search-input:focus {
            border-color: #304ffe;
        }

        .search-results {
            flex: 1;
            overflow-y: auto;
        }

        .search-item {
            padding: 14px 20px;
            padding-left: 16px;
            border-bottom: 1px solid #f0f0f0;
            border-left: 4px solid #777;
            cursor: pointer;
            transition: background .2s;
        }

        .search-item:hover {
            background: #f5f7fb;
        }

        .search-item.active {
            background: #eef2ff;
            border-left: 4px solid #304ffe;
        }

        .search-word {
            font-size: 20px;
            font-weight: bold;
        }

        .search-word-type {
            color: #777;
            margin-top: 3px;
            font-size: 14px;
        }

        /* ===========================
            Content
        ============================ */

        .content {
            flex: 1;
            overflow-y: auto;
            padding: 40px;
        }

        .container {
            max-width: 900px;
            margin: auto;
        }

        .header {
            background: white;
            padding: 24px;
            border-radius: 14px;
            margin-bottom: 24px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, .05);
        }

        .header h1 {
            margin: 0;
            font-size: 38px;
        }

        .meta {
            margin-top: 10px;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .badge {
            background: #eef2ff;
            color: #304ffe;
            padding: 6px 12px;
            border-radius: 999px;
            font-size: 14px;
        }

        .entry {
            background: white;
            border-radius: 14px;
            padding: 22px;
            margin-bottom: 20px;
            box-shadow: 0 6px 20px rgba(0, 0, 0, .06);
        }

        .entry-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .slug {
            font-size: 30px;
            font-weight: bold;
        }

        .common {
            background: #4caf50;
            color: white;
            padding: 5px 12px;
            border-radius: 999px;
            font-size: 13px;
        }

        .jlpt {
            background: #ff9800;
            color: white;
            padding: 5px 12px;
            border-radius: 999px;
            margin-left: 8px;
            font-size: 13px;
        }

        .section {
            margin-top: 18px;
        }

        .section h3 {
            margin-bottom: 10px;
            color: #666;
            font-size: 15px;
            text-transform: uppercase;
            letter-spacing: .08em;
        }

        .word {
            display: inline-block;
            margin: 6px;
            padding: 10px 14px;
            background: #f2f4f8;
            border-radius: 10px;
        }

        .word strong {
            display: block;
            font-size: 22px;
        }

        .word span {
            color: #666;
        }

        .sense {
            padding: 12px;
            border-left: 4px solid #3f51b5;
            background: #fafbff;
            margin-bottom: 10px;
        }

        .definitions {
            font-size: 17px;
            margin-bottom: 8px;
        }

        .tags {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 8px;
        }

        .tag {
            background: #ececec;
            border-radius: 999px;
            padding: 4px 10px;
            font-size: 13px;
        }
    </style>
</head>

<body>
    <div class="layout">
        <aside class="sidebar">
            <div class="sidebar-header">
                <h2>Word list</h2>
                <input id="searchInput" class="search-input" type="text" placeholder="Search Japanese..."
                    autocomplete="off">
            </div>
            <div id="searchResults" class="search-results">
                <!-- Search results inserted here -->
                <!-- Example -->
                <!--
                <div class="search-item active">
                    <div class="search-word">買い物</div>
                    <div class="search-word-type">かいもの</div>
                </div>
                <div class="search-item">
                    <div class="search-word">買い物帰り</div>
                    <div class="search-word-type">かいものがえり</div>
                </div>
                -->
            </div>
        </aside>
        <main class="content">
            <div class="container">
                <div class="header">
                    <h1 id="basicForm"></h1>
                    <div class="meta">
                        <div id="tokenId" class="badge"></div>
                        <div id="wordType" class="badge"></div>
                        <div id="count" class="badge"></div>
                    </div>
                </div>
                <div id="entries"></div>
            </div>
        </main>
    </div>
    <script src="/index.js"></script>
</body>

</html>
