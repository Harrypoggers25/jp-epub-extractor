<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Japanese Dictionary Result</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 40px;
            background: #f5f7fb;
            font-family: Inter, Arial, sans-serif;
            color: #222;
        }

        .container {
            max-width: 900px;
            margin: auto;
        }

        .header {
            background: white;
            padding: 24px;
            border-radius: 14px;
            margin-bottom: 24px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);
        }

        .header h1 {
            margin: 0;
            font-size: 38px;
        }

        .meta {
            margin-top: 10px;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .badge {
            background: #eef2ff;
            color: #304ffe;
            padding: 6px 12px;
            border-radius: 999px;
            font-size: 14px;
        }

        .entry {
            background: white;
            border-radius: 14px;
            padding: 22px;
            margin-bottom: 20px;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.06);
        }

        .entry-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .slug {
            font-size: 30px;
            font-weight: bold;
        }

        .common {
            background: #4caf50;
            color: white;
            padding: 5px 12px;
            border-radius: 999px;
            font-size: 13px;
        }

        .jlpt {
            background: #ff9800;
            color: white;
            padding: 5px 12px;
            border-radius: 999px;
            margin-left: 8px;
            font-size: 13px;
        }

        .section {
            margin-top: 18px;
        }

        .section h3 {
            margin-bottom: 10px;
            color: #666;
            font-size: 15px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        .word {
            display: inline-block;
            margin: 6px;
            padding: 10px 14px;
            background: #f2f4f8;
            border-radius: 10px;
        }

        .word strong {
            display: block;
            font-size: 22px;
        }

        .word span {
            color: #666;
        }

        .sense {
            padding: 12px;
            border-left: 4px solid #3f51b5;
            background: #fafbff;
            margin-bottom: 10px;
        }

        .definitions {
            font-size: 17px;
            margin-bottom: 8px;
        }

        .tags {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 8px;
        }

        .tag {
            background: #ececec;
            border-radius: 999px;
            padding: 4px 10px;
            font-size: 13px;
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="header">
            <h1 id="basicForm"></h1>
            <div class="meta">
                <div class="badge" id="tokenId"></div>
                <div class="badge" id="wordType"></div>
                <div class="badge" id="count"></div>
            </div>
        </div>
        <div id="entries"></div>
    </div>
    <script src="/index.js"></script>
</body>

</html>
