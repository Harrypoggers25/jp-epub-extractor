<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Japanese Dictionary</title>

    <style>
        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            height: 100%;
            font-family: "Noto Sans JP", Inter, Arial, sans-serif;
            background: #181a1b;
            color: #e8e6e3;
        }

        .layout {
            display: flex;
            height: 100vh;
        }

        /* ===========================
            Sidebar
        ============================ */

        .sidebar {
            width: 320px;
            background: #1e2021;
            border-right: 1px solid #333;
            display: flex;
            flex-direction: column;
        }

        .sidebar-header {
            padding: 20px;
            border-bottom: 1px solid #2a2c2d;
        }

        .sidebar-header h2 {
            margin: 0 0 16px;
            font-size: 24px;
            color: #e8e6e3;
        }

        .search-input {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid #444;
            border-radius: 10px;
            font-size: 15px;
            outline: none;
            background: #131415;
            color: #e8e6e3;
        }

        .search-input:focus {
            border-color: #7c8aff;
        }

        .search-results {
            flex: 1;
            overflow-y: auto;
        }

        .search-item {
            display: flex;
            justify-content: space-between;
            padding: 14px 20px;
            padding-left: 16px;
            border-bottom: 1px solid #262829;
            border-left: 4px solid #999;
            cursor: pointer;
            transition: background .2s;
            color: #e8e6e3;
        }

        .search-item:focus,
        .search-item:focus-visible,
        .search-item:active {
            outline: none !important;
            box-shadow: none !important;
        }

        .search-item.unique {
            background: #332b0f;
            border-left: 4px solid #d9b64c;
        }

        .search-item.error {
            background: #2b1414;
            border-left: 4px solid #e05c5c;
        }

        .search-item.active {
            background: #1b2038;
            border-left: 4px solid #7c8aff;
        }

        .search-item.modified {
            background: #14211a;
            border-left: 4px solid #5cbf60;
        }

        .search-item:is(:hover, :focus) {
            background: #272a2b;
            border-left: 4px solid #999;
            color: #999;
        }

        .search-item.unique:is(:hover, :focus) {
            background: #3d331a;
            border-left: 4px solid #d9b64c;
            color: #d9b64c;
        }

        .search-item.error:is(:hover, :focus) {
            background: #331a1a;
            border-left: 4px solid #e05c5c;
            color: #e05c5c;
        }

        .search-item.active:is(:hover, :focus) {
            background: #232b4d;
            border-left: 4px solid #7c8aff;
            color: #7c8aff;
        }

        .search-item.modified:is(:hover, :focus) {
            background: #1b2d23;
            border-left: 4px solid #5cbf60;
            color: #5cbf60;
        }

        .search-item.merged .search-tag-merged {
            color: #e8e6e3;
        }

        .search-item.unsure .search-tag-unsure {
            color: #e8e6e3;
        }

        .search-item.ignore .search-tag-ignore {
            color: #e8e6e3;
        }

        .search-word {
            font-size: 20px;
            font-weight: bold;
        }

        .search-word-type {
            color: #999;
            margin-top: 3px;
            font-size: 14px;
        }

        .search-item-tags {
            display: flex;
            flex-direction: column;
        }

        .search-item-tags>div {
            align-self: center;
            color: #444;
            font-size: 12px;
            font-weight: bold;
        }

        .sidebar-footer {
            display: flex;
            justify-content: center;
            padding: 5px;
            font-size: 15px;
            font-weight: bold;
            border-top: 1px solid #2a2c2d;
            color: #e8e6e3;
        }

        /* ===========================
            Content
        ============================ */

        .content {
            flex: 1;
            overflow-y: auto;
            padding: 40px;
        }

        .container {
            max-width: 900px;
            margin: auto;
        }

        .header {
            background: #1e2021;
            padding: 24px;
            border-radius: 14px;
            margin-bottom: 24px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, .4);
            border: 1px solid #333;
            display: flex;
            justify-content: space-between;
            gap: 20px;
            align-items: stretch;
        }

        .header-actions {
            display: flex;
            flex-direction: column;
            gap: 8px;
            justify-content: center;
            flex-shrink: 0;
        }

        .header-btn {
            background: #232527;
            color: #e8e6e3;
            border: 2px solid #333;
            border-radius: 8px;
            padding: 8px 14px;
            font-size: 13px;
            cursor: pointer;
            white-space: nowrap;
            transition: background .2s, border-color .2s;
            text-align: left;
        }

        .header-btn:focus,
        .header-btn:focus-visible,
        .header-btn:active {
            outline: none !important;
        }

        .header-btn:is(:hover, :focus) {
            background: #272a2b;
            border-color: #7c8aff;
            box-shadow: 0 8px 30px rgba(21, 62, 255, 0.27);
            color: #7c8aff;
        }

        .header-btn.selected {
            border-color: #5cbf60;
        }

        .header-btn.selected:is(:hover, :focus) {
            color: #5cbf60;
            box-shadow: 0 8px 30px rgba(76, 175, 80, .22);
        }

        .header-btn:disabled,
        .header-btn:disabled:is(:hover, :focus) {
            background: #1a1c1d;
            color: #5a5c5d;
            border-color: #2a2c2d;
            cursor: default;
            box-shadow: none;
        }

        .header-content {
            flex: 1;
            min-width: 0;
        }

        .header h1 {
            margin: 0;
            font-size: 38px;
            color: #e8e6e3;
        }

        .meta {
            margin-top: 10px;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .badge {
            background: #1b2038;
            color: #7c8aff;
            padding: 6px 12px;
            border-radius: 999px;
            font-size: 14px;
            align-content: center;
        }

        .badge.hidden {
            display: none;
        }

        #mergeCount {
            background: #332b0f;
            color: #d9b64c;
        }

        #mergeWith {
            background: #1b2d23;
            color: #5cbf60;
        }

        .entry {
            background: #1e2021;
            border-radius: 14px;
            padding: 22px;
            margin-bottom: 20px;
            border: 2px solid #333;
            box-shadow: 0 8px 30px rgba(0, 0, 0, .5);
            cursor: pointer;
        }

        .entry:focus,
        .entry:focus-visible,
        .entry:active {
            outline: none !important;
        }

        .entry:is(:hover, :focus) {
            background: #272a2b;
            border-color: #7c8aff;
            box-shadow: 0 8px 30px rgba(21, 62, 255, 0.27);
        }

        .entry:is(:hover, :focus) .slug {
            color: #7c8aff;
        }

        .entry.selected {
            border-color: #5cbf60;
        }

        .entry.selected:is(:hover, :focus) {
            box-shadow: 0 8px 30px rgba(76, 175, 80, .22);
        }

        .entry.selected:is(:hover, :focus) .slug {
            color: #5cbf60;
        }

        .entry-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .entry.disabled {
            background: #1a1c1d;
            border-color: #2a2c2d;
            cursor: default;
            box-shadow: none;
        }

        .entry.disabled .slug {
            color: #5a5c5d;
        }

        .entry.disabled:is(:hover, :focus) {
            background: #1a1c1d;
            border-color: #2a2c2d;
            box-shadow: none;
        }

        .entry.disabled:is(:hover, :focus) .slug {
            color: #5a5c5d;
        }

        .entry.disabled.selected {
            border-color: #2f4a31;
            box-shadow: none;
        }

        .entry.disabled.selected:is(:hover, :focus) {
            border-color: #2f4a31;
            box-shadow: none;
        }

        .entry.disabled.selected:is(:hover, :focus) .slug {
            color: #5a5c5d;
        }

        .entry.disabled .section h3 {
            color: #4a4c4d;
        }

        .entry.disabled .word {
            background: #1f2122;
        }

        .entry.disabled .word strong {
            color: #5a5c5d;
        }

        .entry.disabled .word span {
            color: #4a4c4d;
        }

        .entry.disabled .sense {
            background: #131415;
            border-left-color: #3a3d47;
        }

        .entry.disabled .definitions {
            color: #5a5c5d;
        }

        .entry.disabled .tags .tag {
            background: #202122;
            color: #6a6c6d;
        }

        .entry.disabled .common {
            background: #2f4a31;
            color: #5a5c5d;
        }

        .entry.disabled .jlpt {
            background: #4a3b1f;
            color: #5a5c5d;
        }

        .slug {
            font-size: 30px;
            font-weight: bold;
            color: #e8e6e3;
        }

        .common {
            background: #5cbf60;
            color: #0d0f0f;
            padding: 5px 12px;
            border-radius: 999px;
            font-size: 13px;
        }

        .jlpt {
            background: #ffab40;
            color: #0d0f0f;
            padding: 5px 12px;
            border-radius: 999px;
            margin-left: 8px;
            font-size: 13px;
        }

        .section {
            margin-top: 18px;
        }

        .section h3 {
            margin-bottom: 10px;
            color: #999;
            font-size: 15px;
            text-transform: uppercase;
            letter-spacing: .08em;
        }

        .word {
            display: inline-block;
            margin: 6px;
            padding: 10px 14px;
            background: #232527;
            border-radius: 10px;
        }

        .word strong {
            display: block;
            font-size: 22px;
            color: #e8e6e3;
        }

        .word span {
            color: #999;
        }

        .sense {
            padding: 12px;
            border-left: 4px solid #7986cb;
            background: #16181d;
            margin-bottom: 10px;
        }

        .definitions {
            font-size: 17px;
            margin-bottom: 8px;
            color: #e8e6e3;
        }

        .tags {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 8px;
        }

        .tag {
            background: #2c2c2c;
            border-radius: 999px;
            padding: 4px 10px;
            font-size: 13px;
            color: #ccc;
        }

        /* ===========================
            Modal overlay
        ============================ */

        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, .6);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1000;
        }

        .modal-overlay.open {
            display: flex;
        }

        .modal-box {
            background: #1e2021;
            border: 1px solid #333;
            border-radius: 14px;
            padding: 20px;
            width: 100%;
            max-width: 420px;
            max-height: 70vh;
            box-shadow: 0 8px 30px rgba(0, 0, 0, .5);
            display: flex;
            flex-direction: column;
        }

        .modal-box h3 {
            margin: 0 0 14px;
            font-size: 18px;
            color: #e8e6e3;
            flex-shrink: 0;
        }

        .modal-box h3 span {
            color: #999;
        }

        .modal-search {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #444;
            border-radius: 10px;
            font-size: 14px;
            outline: none;
            background: #131415;
            color: #e8e6e3;
            margin-bottom: 14px;
            flex-shrink: 0;
        }

        .modal-search:focus {
            border-color: #7c8aff;
        }

        .modal-list {
            overflow-y: auto;
            border: 1px solid #262829;
            border-radius: 10px;
            margin-bottom: 20px;
        }

        .modal-item {
            padding: 12px 16px;
            border-bottom: 1px solid #262829;
            border-left: 4px solid #999;
            cursor: pointer;
            transition: background .2s;
            color: #e8e6e3;
        }

        .modal-item:last-child {
            border-bottom: none;
        }

        .modal-item:focus,
        .modal-item:focus-visible,
        .modal-item:active {
            outline: none !important;
        }

        .modal-item:is(:hover, :focus) {
            background: #272a2b;
            border-left: 4px solid #999;
            color: #999;
        }

        .modal-item.selected {
            background: #1b2038;
            border-left: 4px solid #7c8aff;
        }

        .modal-item.selected:is(:hover, :focus) {
            background: #232b4d;
            border-left: 4px solid #7c8aff;
            color: #7c8aff;
        }

        .modal-item-word {
            font-size: 16px;
            font-weight: bold;
        }

        .modal-item-type {
            color: #999;
            margin-top: 2px;
            font-size: 13px;
        }

        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            flex-shrink: 0;
        }

        .modal-btn {
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 13px;
            cursor: pointer;
            border: 1px solid #333;
            background: #232527;
            color: #e8e6e3;
            transition: background .2s, border-color .2s;
        }

        .modal-btn:hover {
            background: #272a2b;
            border-color: #7c8aff;
        }

        .modal-btn.confirm {
            background: #1b2038;
            border-color: #7c8aff;
            color: #7c8aff;
        }

        .modal-btn.confirm:hover {
            background: #232b4d;
        }

        .modal-btn.confirm:disabled {
            background: #1a1c1d;
            color: #5a5c5d;
            border-color: #2a2c2d;
            cursor: default;
        }

        #sentenceModal .modal-box {
            max-width: 80vw;
            max-height: 75vh;
        }

        #sentenceModal .modal-list {
            display: flex;
            flex-direction: row-reverse;
            overflow-x: auto;
            overflow-y: hidden;
            height: 50vh;
            padding: 10px 6px;
        }

        #sentenceModal .modal-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            flex-shrink: 0;
            border-bottom: none;
            border-left: none;
            border-right: 4px solid #999;
            padding: 8px 14px;
            margin-right: 20px;
            height: 100%;
        }

        #sentenceModal .modal-item:is(:hover, :focus) {
            border-right: 4px solid #999;
        }

        #sentenceModal .modal-item.selected {
            border-right: 4px solid #7c8aff;
        }

        #sentenceModal .modal-item.selected:is(:hover, :focus) {
            border-right: 4px solid #7c8aff;
        }

        #sentenceModal .modal-item-header {
            writing-mode: horizontal-tb;
            color: #999;
            font-size: 12px;
            margin-bottom: 8px;
            flex-shrink: 0;
        }

        #sentenceModal .modal-item-text {
            writing-mode: vertical-rl;
            text-orientation: mixed;
            font-size: 16px;
            line-height: 1.9;
            letter-spacing: 0.05em;
            height: 100%;
            color: #e8e6e3;
        }
    </style>
</head>

<body>
    <div class="layout">
        <aside class="sidebar">
            <div class="sidebar-header">
                <h2>Word list</h2>
                <input id="searchInput" class="search-input" type="text" placeholder="Search Japanese..."
                    autocomplete="off">
            </div>
            <div id="searchResults" class="search-results">
                <!-- <div class="search-item"> -->
                <!--     <div class="search-word">買い物帰り</div> -->
                <!--     <div class="search-word-type">かいものがえり</div> -->
                <!-- </div> -->
            </div>
            <div class="sidebar-footer">
                <span id="searchResultCount"></span>
            </div>
        </aside>
        <main class="content">
            <div class="container">
                <div class="header">
                    <div class="header-content">
                        <h1 id="basicForm"></h1>
                        <div class="meta">
                            <div id="tokenId" class="badge"></div>
                            <div id="wordType" class="badge"></div>
                            <div id="count" class="badge"></div>
                            <div id="occurrence" class="badge"></div>
                        </div>
                        <div class="meta">
                            <div id="mergeCount" class="badge hidden"></div>
                            <div id="mergeWith" class="badge hidden"></div>
                        </div>
                    </div>
                    <div id="headerActions" class="header-actions">
                        <!-- <button class="header-btn" id="btnUnimportant">Unimportant</button> -->
                        <!-- <button class="header-btn" id="btnIgnore">Ignore</button> -->
                        <!-- <button class="header-btn" id="btnMerge">Merge with...</button> -->
                    </div>
                </div>
                <div id="entries"></div>
            </div>
        </main>
    </div>
    <div class="modal-overlay" id="mergeModal">
        <div class="modal-box">
            <h3>Selected word: <span id="mergeModalTargetWord"></span></h3>
            <h3>Merge with: <span id="mergeModalSelectedWord"></span></h3>
            <input id="mergeModalSearchInput" class="modal-search" type="text" placeholder="Search entries..."
                autocomplete="off">
            <div class="modal-list" id="mergeModalList">
                <!-- <div class="modal-item"> -->
                <!--     <div class="modal-item-word">動く</div> -->
                <!--     <div class="modal-item-type">動詞</div> -->
                <!-- </div> -->
            </div>
            <div class="modal-actions">
                <button class="modal-btn" id="mergeModalCancel">Cancel</button>
                <button class="modal-btn confirm" id="mergeModalConfirm">Confirm</button>
            </div>
        </div>
    </div>
    <div class="modal-overlay" id="sentenceModal">
        <div class="modal-box">
            <h3>Reference word: <span id="sentenceModalReferenceWord"></span></h3>
            <div class="modal-list" id="sentenceModalList">
                <!-- <div class="modal-item"> -->
                <!--     <div class="modal-item-header">1:1</div> -->
                <!--     <div class="modal-item-text">私はリンゴが好きです</div> -->
                <!-- </div> -->
            </div>
        </div>
    </div>
    <script type="module" src="/tools.helper.js"></script>
    <script type="module" src="/api.helper.js"></script>
    <script type="module" src="/index.js"></script>
</body>

</html>
