<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Japanese Epub Dictionary</title>

    <link rel="stylesheet" href="/css/shared.css">
    <link rel="stylesheet" href="/css/table.css">
    <link rel="stylesheet" href="/css/word.css">
</head>

<body>
    <div class="word-layout">
        <main class="content">
            <div class="container">
                <div class="header">
                    <div class="header-content">
                        <h1>Japanese Epub Dictionary</h1>
                    </div>
                    <div class="header-actions">
                        <a class="header-btn" href="/book">New book</a>
                        <a class="header-btn" href="/review/unsure">Unsure words</a>
                        <div id="wordExport" class="table-export word-export">
                            <button id="btnExport" class="header-btn word-export-button" aria-haspopup="menu" aria-expanded="false"
                                disabled>Export</button>
                            <div id="exportMenu" class="table-export-menu" aria-hidden="true">
                                <button id="btnExportJson" class="table-export-item" type="button">JSON</button>
                                <button id="btnExportFormatted" class="table-export-item" type="button">JSON formatted</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="table-panel">
                    <div class="table-toolbar">
                        <input id="wordSearch" class="table-search" type="text" placeholder="Search words..."
                            autocomplete="off" aria-label="Search words" disabled>
                    </div>
                    <div id="wordTable" class="table-region" aria-label="Permanent words"></div>
                </div>
            </div>
        </main>
    </div>

    <div id="wordDetailModal" class="overlay" aria-hidden="true"></div>
    <div id="wordMergeModal" class="overlay" aria-hidden="true"></div>

    <script type="module" src="/tools.helper.js"></script>
    <script type="module" src="/api.helper.js"></script>
    <script type="module" src="/word.js"></script>
</body>

</html>
